# ===============================================================
# Grid Guard Solar Monitoring - Environment Configuration Template
# For production: set VITE_API_URL to your deployed Cloud Run URL
# (e.g. https://grid-guard-api-xxxxxx-uc.a.run.app)
# ===============================================================

# Frontend Backend API Endpoint
VITE_API_URL=http://127.0.0.1:8000
VITE_BACKEND_API_URL=http://127.0.0.1:8000
VITE_ML_API_URL=http://127.0.0.1:8000

# Firebase Web Client Configuration (from Firebase Console Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=gridguardsolarmonitoring.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://gridguardsolarmonitoring-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=gridguardsolarmonitoring
VITE_FIREBASE_STORAGE_BUCKET=gridguardsolarmonitoring.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://gridguardsolarmonitoring.web.app,https://gridguardsolarmonitoring.firebaseapp.com

# Backend Secrets (Set in Google Cloud Run environment variables or local .env)
ADMIN_EMAIL=admin@gridguard.io
ADMIN_INITIAL_PASSWORD=YourSecurePassword123!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_sender@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Grid Guard Solar <your_gmail_sender@gmail.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
HOST=0.0.0.0
